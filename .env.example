PAYLOAD_SECRET=mygeneratedsecret
# PostgreSQL connection string (use for local and production)
DATABASE_URL=postgresql://user:password@localhost:5432/template

COMPANY_NAME="Payload Inc."
# Optional: address for invoices (multiple lines supported via \n)
# COMPANY_ADDRESS="123 Main St\nCity, State ZIP"
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

# Server URLs (required for admin, webhooks, and canonical URLs)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Project type: ecommerce | booking | hybrid (optional, default: ecommerce)
PROJECT_TYPE=ecommerce

# Feature flags (optional)
ENABLE_BOOKING=false
ENABLE_INVOICES=true

# Theme: font presets (optional, default: geist). Edit src/config/theme.ts for full palette.
# FONT_SANS=geist
# FONT_MONO=geist

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# SMTP (optional; if not set, order/form emails are disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_
