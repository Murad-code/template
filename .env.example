# =============================================================================
# Core (required)
# =============================================================================
PAYLOAD_SECRET=                            # Secret for signing JWTs/sessions (generate a long random string)
DATABASE_URL=postgresql://user:password@localhost:5432/template

# =============================================================================
# Server URLs (admin, webhooks, canonical links)
# =============================================================================
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# =============================================================================
# Branding & site
# =============================================================================
SITE_NAME=Payload Commerce
COMPANY_NAME=Payload Commerce
# COMPANY_ADDRESS=123 Main St\nCity, Postcode
# TWITTER_CREATOR=@handle
# TWITTER_SITE=https://example.com
# PROJECT_TYPE=ecommerce                 # ecommerce | booking | hybrid
# ENABLE_BOOKING=false
# ENABLE_INVOICES=true
# FONT_SANS=geist
# FONT_MONO=geist

# =============================================================================
# Invoices (UK Gov compliant – optional)
# =============================================================================
# COMPANY_PHONE=
# COMPANY_EMAIL=
# COMPANY_VAT_NUMBER=                     # Show VAT on invoice when set with VAT_RATE_PERCENT
# VAT_RATE_PERCENT=20
# SOLE_TRADER_LEGAL_NAME=                # Your name (sole traders)
# SOLE_TRADER_LEGAL_ADDRESS=             # Address for legal documents when using a business name

# =============================================================================
# Preview (draft preview in frontend)
# =============================================================================
PREVIEW_SECRET=demo-draft-secret

# =============================================================================
# Email (order confirmations, password reset, form notifications)
# =============================================================================
# Resend (recommended): set RESEND_API_KEY or SENDGRID_API_KEY if it starts with re_
# RESEND_API_KEY=
# SendGrid: SENDGRID_API_KEY (or use SMTP below)
# SENDGRID_API_KEY=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Site
# Generic SMTP (used when no Resend/SendGrid key)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# =============================================================================
# Stripe (payments & refunds)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_
