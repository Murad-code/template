# ------------------------------------------------------------------------------
# Local configuration
# Copy to `.env` and fill in values. Do not commit `.env`.
# ------------------------------------------------------------------------------

# =============================================================================
# Required — Payload & database
# =============================================================================

# Signs JWTs, sessions, and booking cancel tokens (use a long random string).
PAYLOAD_SECRET=

# Postgres connection string (adapter-specific; see project README).
DATABASE_URL=postgresql://user:password@localhost:5432/template

# =============================================================================
# Required — public URLs
# =============================================================================

# Server-side canonical URL (admin, webhooks, links generated on the server).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Browser-accessible site URL (same origin as the app in typical dev setups).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# =============================================================================
# Site & behaviour (optional; sensible defaults in code)
# =============================================================================

SITE_NAME=Payload Commerce
COMPANY_NAME=Payload Commerce
NEXT_PUBLIC_COMPANY_NAME=Payload Commerce
# Optional: brand assets used across frontend + admin/login.
# Use absolute URLs or root-relative paths (e.g. /brand/logo.svg) served by this app.
# NEXT_PUBLIC_BRAND_LOGO_URL=
# NEXT_PUBLIC_BRAND_ICON_URL=

# COMPANY_ADDRESS=                        # e.g. "123 Main St\nCity, Postcode"
# COMPANY_PHONE=
# COMPANY_EMAIL=

# TWITTER_CREATOR=@handle
# TWITTER_SITE=https://example.com

# PROJECT_TYPE=ecommerce                  # ecommerce = shop only | booking = services only | hybrid = both
# ENABLE_INVOICES=true                    # default on unless set to false

# FONT_SANS=geist
# FONT_MONO=geist

# =============================================================================
# Invoices (UK-oriented; all optional)
# =============================================================================

# COMPANY_VAT_NUMBER=                     # with VAT_RATE_PERCENT shows VAT on invoices
# VAT_RATE_PERCENT=20
# SOLE_TRADER_LEGAL_NAME=
# SOLE_TRADER_LEGAL_ADDRESS=

# =============================================================================
# Draft preview
# =============================================================================

# Query param secret for `/next/preview` draft URLs.
PREVIEW_SECRET=demo-draft-secret

# =============================================================================
# Email (orders, password reset, forms, booking mail)
# =============================================================================
#
# Resend (@payloadcms/email-resend): set RESEND_API_KEY (re_… from https://resend.com/api-keys).
# SMTP_FROM_* = default From for Resend (Payload's usual env names; not SMTP-only).
# Fallback: leave RESEND_API_KEY unset and configure SMTP_HOST (+ auth) for Nodemailer.
#

# Resend API key (re_…).
# RESEND_API_KEY=

# Default From (verify this domain in Resend before sending).
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Site

# Generic SMTP (only used when RESEND_API_KEY is unset and SMTP_HOST is set).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# =============================================================================
# Stock (optional)
# =============================================================================
#
# Low-stock email when inventory crosses from above threshold to at/below it (update only).
# ENABLE_LOW_STOCK_ALERTS=true
# LOW_STOCK_ALERT_TO=ops@example.com          # default: SMTP_FROM_EMAIL
#
# TTL reservations while items are in carts (see README → Products and Variants).
# ENABLE_CART_STOCK_RESERVATION=true
# CART_RESERVATION_TTL_MINUTES=15
# STOCK_RESERVATION_CLEANUP_SECRET=long-random   # Bearer for POST /api/stock-reservations/cleanup-expired

# =============================================================================
# Stripe (checkout, refunds, booking deposits)
# =============================================================================

STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# =============================================================================
# Vercel (set automatically on Vercel; rarely needed locally)
# =============================================================================

# NEXT_PUBLIC_VERCEL_URL=
# VERCEL_PROJECT_PRODUCTION_URL=

# =============================================================================
# Docker build (optional; used by scripts/docker-build-amd64.sh)
# =============================================================================

# Image name and tag for Docker builds (e.g. muradkamali/template:1.0.0)
# DOCKER_IMAGE=muradkamali/template:1.0.0

# Optional: separate 32+ char secret used only during docker build (avoid coupling to runtime secret)
# PAYLOAD_SECRET_BUILD=

# Docker Postgres connection (local dev only)
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=template
POSTGRES_HOST_PORT=5433

